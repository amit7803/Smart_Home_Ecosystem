/*
 * ESP32 WROVER -> Input GPIO13 Monitor
 * If pin13 pressed (LOW with INPUT_PULLUP) => send ON command to ESP8266
 * Else => send OFF command
 */

#include <WiFi.h>
#include <PubSubClient.h>

// ==========================================
// WIFI CONFIG
// ==========================================
const char* ssid     = "SSID";
const char* password = "PASS";

// ==========================================
// MQTT CONFIG
// ==========================================
const char* mqtt_server = "broker.hivemq.com";
const int   mqtt_port   = PORT;

// ESP32 Device ID
const char* device_id = "UNIQUE ID";

// Topic (same command topic of ESP8266)
const char* topic_command = "ESP/TOPIC/CMD";
const char* topic_status  = "ESP/TOPIC/STATUS";

// ==========================================
// OBJECTS
// ==========================================
WiFiClient espClient;
PubSubClient client(espClient);

// ==========================================
// PIN CONFIG
// ==========================================
#define INPUT_PIN 13

// ==========================================
// VARIABLES
// ==========================================
bool lastState = HIGH;
unsigned long lastReconnectAttempt = 0;

// ==========================================
// WIFI CONNECT
// ==========================================
void setup_wifi() {
  Serial.println();
  Serial.print("Connecting WiFi: ");
  Serial.println(ssid);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());
}

// ==========================================
// MQTT RECONNECT
// ==========================================
void reconnect() {
  while (!client.connected()) {

    Serial.print("Connecting MQTT...");

    if (client.connect(device_id)) {
      Serial.println("Connected");
      client.publish(topic_status, "online", true);
    } else {
      Serial.print("Failed rc=");
      Serial.print(client.state());
      Serial.println(" retry in 5 sec");
      delay(5000);
    }
  }
}

// ==========================================
// SETUP
// ==========================================
void setup() {
  Serial.begin(115200);

  pinMode(INPUT_PIN, INPUT_PULLUP);

  setup_wifi();

  client.setServer(mqtt_server, mqtt_port);
}

// ==========================================
// LOOP
// ==========================================
void loop() {

  if (WiFi.status() != WL_CONNECTED) {
    setup_wifi();
  }

  if (!client.connected()) {
    reconnect();
  }

  client.loop();

  bool currentState = digitalRead(INPUT_PIN);

  // State changed?
  if (currentState != lastState) {

    delay(30); // debounce
    currentState = digitalRead(INPUT_PIN);

    if (currentState == LOW) {
      Serial.println("Pin13 Pressed -> Sending ON");
      client.publish(topic_command, "ON");
    } 
    else {
      Serial.println("Pin13 Released -> Sending OFF");
      client.publish(topic_command, "OFF");
    }

    lastState = currentState;
  }
}
